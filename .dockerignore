# Ignore git files
.git
.gitignore
.gitattributes

# Ignore build output
**/bin/
**/obj/
**/out/

# Ignore test results
**/TestResults/
**/*.trx
**/*.coverage

# Ignore logs
**/logs/
*.log

# Ignore IDE files
.vs/
.vscode/
.idea/
*.suo
*.user
