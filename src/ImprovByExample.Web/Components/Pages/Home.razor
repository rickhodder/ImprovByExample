@page "/"


<PageTitle>Home - Improv By Example</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Welcome to Improv By Example</MudText>

<MudText Class="mb-4">
    Your comprehensive resource for improv comedy activities, techniques, and training materials.
</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="4" Class="pa-4">
            <MudCardContent>
                <MudText Typo="Typo.h5" GutterBottom="true">🎭 Browse Activities</MudText>
                <MudText>Search and explore hundreds of improv games, warmups, and techniques.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/activities">Explore</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="4" Class="pa-4">
            <MudCardContent>
                <MudText Typo="Typo.h5" GutterBottom="true">📚 Learn from Sources</MudText>
                <MudText>Discover improv activities from classic books and trusted websites.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" Href="/sources">View Sources</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="4" Class="pa-4">
            <MudCardContent>
                <MudText Typo="Typo.h5" GutterBottom="true">🎬 Watch Demos</MudText>
                <MudText>See activities in action with video demonstrations and examples.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Text" Color="Color.Tertiary" Disabled="true">Coming Soon</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

<MudText Typo="Typo.h4" Class="mt-8 mb-4">Getting Started</MudText>

<MudList T="string">
    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
        <MudText><strong>Browse:</strong> Explore activities by type, difficulty, or source</MudText>
    </MudListItem>
    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
        <MudText><strong>Learn:</strong> Read detailed rules and descriptions for each activity</MudText>
    </MudListItem>
    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
        <MudText><strong>Practice:</strong> Try activities in your classes, rehearsals, or performances</MudText>
    </MudListItem>
</MudList>
