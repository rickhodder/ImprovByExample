@page "/"

<PageTitle>Home - Improv By Example</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Welcome to Improv By Example</MudText>
<MudText Typo="Typo.body1" GutterBottom="true">
    A web application for managing and exploring improv comedy activities including games, techniques, warmups, and exercises.
</MudText>

<MudGrid Class="mt-4">
    <MudItem xs="12" sm="6" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h5" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.Search" /> Browse Activities
                </MudText>
                <MudText Typo="Typo.body2">
                    Search and explore our comprehensive database of improv activities, games, and techniques.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    
    <MudItem xs="12" sm="6" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h5" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" /> Watch Videos
                </MudText>
                <MudText Typo="Typo.body2">
                    View AI-generated demonstration videos showing how each activity is performed.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    
    <MudItem xs="12" sm="6" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h5" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.Event" /> Plan Shows
                </MudText>
                <MudText Typo="Typo.body2">
                    Use our AI-assisted show planner to create balanced performance agendas.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
